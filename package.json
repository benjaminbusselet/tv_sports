{
  "name": "tv_sports",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-check.js && concurrently -n front,server -c blue,green \"vite\" \"node --watch scripts/server.js\"",
    "dev:quick": "concurrently -n front,server -c blue,green \"vite\" \"node --watch scripts/server.js\"",
    "build": "vite build",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.12.2",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.2.5",
    "luxon": "^3.7.2",
    "node-fetch": "^3.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^41.0.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
